#!/usr/bin/env bash
# license_check nvm-style installer

INSTALL_DIR="$HOME/.license-check"
mkdir -p "$INSTALL_DIR"

echo "Installing license_check to $INSTALL_DIR..."

# 1. Extraction and Function Wrapping
# We use a literal string here to avoid any shell expansion 'bleeding'
echo 'license_check() {' > "$INSTALL_DIR/license_check.sh"

PAYLOAD_START=$(awk '/^__PAYLOAD_BELOW__/ {print NR + 1; exit 0;}' "$0")
tail -n +$PAYLOAD_START "$0" >> "$INSTALL_DIR/license_check.sh"

echo '}' >> "$INSTALL_DIR/license_check.sh"

# 2. Add the Hook to .bashrc if missing
HOOK_LINE="[ -s \"$INSTALL_DIR/license_check.sh\" ] && \. \"$INSTALL_DIR/license_check.sh\""

if ! grep -qs "license_check.sh" "$HOME/.bashrc"; then
    echo "Adding hook to ~/.bashrc..."
    echo "" >> "$HOME/.bashrc"
    echo "# license_check shell function loader" >> "$HOME/.bashrc"
    echo "$HOOK_LINE" >> "$HOME/.bashrc"
fi

echo "✅ Done! Run 'source ~/.bashrc' to enable the 'license_check' command."
exit 0

__PAYLOAD_BELOW__
